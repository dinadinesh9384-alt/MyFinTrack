<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. The UI is drawn by Jetpack Compose (see theme/Theme.kt);
         this XML theme only controls the window before Compose draws, so it matches the dark app
         background to avoid a white flash at launch. -->
    <style name="Theme.MyFinTrack" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/fin_accent</item>
        <item name="colorPrimaryVariant">@color/fin_bg</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/fin_accent</item>
        <item name="colorSecondaryVariant">@color/fin_accent</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowBackground">@color/fin_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
